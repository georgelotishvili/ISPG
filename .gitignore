# Ignore everything by default.
*

# Keep this ignore file visible in the repository.
!/.gitignore

# Local archive / old theory copies.
/old/

# RMG theory: publish only source/result files that matter.
!/RMG/
!/RMG/**/
!/RMG/**/*.tex
!/RMG/**/*.bib
!/RMG/**/*.pdf
!/RMG/**/*.py
!/RMG/**/*.txt
!/RMG/**/*.csv
!/RMG/**/*.json
!/RMG/**/*.png
!/RMG/**/*.jpg
!/RMG/**/*.jpeg
!/RMG/**/*.svg

# Same rules if the folder is renamed to "RMG Theory".
!/RMG Theory/
!/RMG Theory/**/
!/RMG Theory/**/*.tex
!/RMG Theory/**/*.bib
!/RMG Theory/**/*.pdf
!/RMG Theory/**/*.py
!/RMG Theory/**/*.txt
!/RMG Theory/**/*.csv
!/RMG Theory/**/*.json
!/RMG Theory/**/*.png
!/RMG Theory/**/*.jpg
!/RMG Theory/**/*.jpeg
!/RMG Theory/**/*.svg

# Internal RMG development story; keep local only.
/RMG/story/
/RMG/story/**

# Internal RMG working notes; keep local only.
/RMG/work/
/RMG/work/**
